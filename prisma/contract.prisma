// use prisma-8
model User {
  id         Int         @id @default(autoincrement())
  clerkId    String      @unique
  role       String      @default("PLAYER")
  email      String      @unique
  name       String?
  createdAt  DateTime    @default(now())
  lastLoginAt DateTime?
  lastLoginSessionId String?
  lastNotificationReadAt DateTime?
  characters Character[]
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
}

model Character {
  id        Int                 @id @default(autoincrement())
  name      String
  flair     String?
  avatarPath String?
  themePalette Json?
  userId    Int
  user      User                @relation(fields:[userId], references:[id])
  skillCreationCredits Int     @default(0)
  age       Int?
  gender    String?
  height    Int?
  stats     CharacterStat?
  resources CharacterResource?
  modifiers CharacterModifier[]
  perks CharacterPerk[]
  skills Skill[]
  createdAt DateTime            @default(now())
  auditLogs AuditLog[]
  knownCharacters CharacterRelationship[] @relation("CharacterKnows")
  knownByCharacters CharacterRelationship[] @relation("CharacterKnownBy")
  mazePositions MazeCharacterPosition[]
  businessesOwned Business[] @relation("BusinessOwner")
  positionsPaid BusinessPosition[] @relation("PositionPayer")
  employmentContracts EmploymentContract[] @relation("EmploymentCharacter")
  economyPaymentsReceived EconomyPaymentLog[]
  properties CharacterProperty[]
  subscriptions BusinessSubscription[]
}

model Skill {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields:[characterId], references:[id], onDelete:Cascade)
  name        String
  cost        Int       @default(0)
  description String?
  duration    String?
  category    String    @default("UTILITY")
  areaOfEffect String?
  speed       String?
  cooldown    String?
  effect      Json      @default("[]")
  condition   String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  approvedAt  DateTime?
  @@index([characterId])
  @@index([status])
}

model CharacterStat {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields:[characterId], references:[id])
  strength     Int       @default(0)
  agility      Int       @default(0)
  constitution Int       @default(0)
  intelligence Int       @default(0)
  wisdom       Int       @default(0)
  charisma     Int       @default(0)
  spirit       Int       @default(0)
  luck         Int       @default(0)

  @@unique([characterId])
}

model CharacterResource {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields:[characterId], references:[id])
  karma       Int       @default(0)
  money       Int       @default(0)
  levelUpPoints Int       @default(0)
  blackjackState String?

  @@unique([characterId])
}

model CharacterModifier {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields:[characterId], references:[id])
  stat        String
  amount      Int
  source      String
  expiresAt   DateTime?
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  actorUserId  Int?
  actorUser    User?    @relation("AuditActor", fields:[actorUserId], references:[id], onDelete:SetNull)
  action       String
  entityType   String
  entityId     Int?
  characterId  Int?
  character    Character? @relation(fields:[characterId], references:[id], onDelete:SetNull)
  targetUserId Int?
  targetUser   User?    @relation("AuditTarget", fields:[targetUserId], references:[id], onDelete:SetNull)
  details      String?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([characterId])
}

model Item {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  itemType       String    @default("OTHER")
  itemSubtype    String?
  acquisitionType String   @default("PURCHASABLE")
  price          Int       @default(0)
  effects        Json
  allowedSlots   Json      @default("[]")
  imagePath      String?
  createdAt      DateTime  @default(now())
  characterItems CharacterItem[]
  properties    CharacterProperty[]
  businessProducts BusinessProduct[]
}

model CharacterItem {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields:[characterId], references:[id], onDelete:Cascade)
  itemId       Int
  item         Item      @relation(fields:[itemId], references:[id], onDelete:Cascade)
  quantity     Int       @default(1)
  equipped     Boolean   @default(false)
  equippedSlot String?
  flair        String?
  createdAt    DateTime  @default(now())
}

model CharacterRelationship {
  id                Int       @id @default(autoincrement())
  characterId       Int
  character         Character @relation("CharacterKnows", fields:[characterId], references:[id], onDelete:Cascade)
  knownCharacterId   Int
  knownCharacter     Character @relation("CharacterKnownBy", fields:[knownCharacterId], references:[id], onDelete:Cascade)
  createdAt         DateTime  @default(now())

  @@unique([characterId, knownCharacterId])
  @@index([characterId])
  @@index([knownCharacterId])
}

model Maze {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  mazeType        String   @default("INFINITE")
  generationMode  String   @default("FREE_3D")
  maxRooms    Int?
  allowTraps  Boolean  @default(true)
  allowDeath  Boolean  @default(true)
  allowTreasures Boolean @default(true)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()
  rooms       MazeRoom[]
  positions   MazeCharacterPosition[]
  themes      MazeTheme[]
}

model MazeRoom {
  id                 Int       @id @default(autoincrement())
  mazeId             Int
  maze               Maze      @relation(fields:[mazeId], references:[id], onDelete:Cascade)
  roomNumber         Int
  roomType           String
  status             String    @default("OPEN")
  description        String
  contentName        String?
  contentDescription String?
  treasureClaimed    Boolean   @default(false)
  treasureRewards   Json      @default("{}")
  trapActive        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  exits              MazeExit[] @relation("MazeExitFrom")
  incomingExits      MazeExit[] @relation("MazeExitTo")
  enemies            MazeRoomEnemy[]
  positions          MazeCharacterPosition[] @relation("MazeRoomPositions")
  previousPositions  MazeCharacterPosition[] @relation("MazeRoomPreviousPositions")
  @@unique([mazeId, roomNumber])
}

model MazeExit {
  id         Int       @id @default(autoincrement())
  mazeId     Int
  maze       Maze      @relation(fields:[mazeId], references:[id], onDelete:Cascade)
  fromRoomId Int
  fromRoom   MazeRoom  @relation("MazeExitFrom", fields:[fromRoomId], references:[id], onDelete:Cascade)
  toRoomId   Int?
  toRoom     MazeRoom? @relation("MazeExitTo", fields:[toRoomId], references:[id], onDelete:Cascade)
  direction  String
  createdAt  DateTime  @default(now())
  @@unique([fromRoomId, direction])
}

model Enemy {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  rank            String    @default("NORMAL")
  stats           Json      @default("{}")
  abilities       Json      @default("[]")
  loot            Json      @default("[]")
  encounterWeight Int       @default(1)
  isBoss          Boolean   @default(false)
  active          Boolean   @default(true)
  imagePath       String?
  capturability   Int       @default(0)
  createdAt       DateTime  @default(now())
  instances       MazeRoomEnemy[]
  themes          EnemyTheme[]
}

model Theme {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  description String?
  imagePath   String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  enemyThemes EnemyTheme[]
  mazeThemes  MazeTheme[]
}

model EnemyTheme {
  enemyId Int
  enemy   Enemy @relation(fields:[enemyId], references:[id], onDelete:Cascade)
  themeId Int
  theme   Theme @relation(fields:[themeId], references:[id], onDelete:Cascade)
  @@id([enemyId, themeId])
}

model MazeTheme {
  mazeId Int
  maze   Maze @relation(fields:[mazeId], references:[id], onDelete:Cascade)
  themeId Int
  theme   Theme @relation(fields:[themeId], references:[id], onDelete:Cascade)
  @@id([mazeId, themeId])
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model MazeRoomEnemy {
  id        Int       @id @default(autoincrement())
  roomId    Int
  room      MazeRoom  @relation(fields:[roomId], references:[id], onDelete:Cascade)
  enemyId   Int
  enemy     Enemy     @relation(fields:[enemyId], references:[id], onDelete:Restrict)
  quantity  Int       @default(1)
  status    String    @default("ACTIVE")
  isMobile  Boolean   @default(false)
  createdAt DateTime  @default(now())
  generatedStats Json    @default("{}")
  focus         String?
  behavior      String?
  targetPower   Int?
  depthMultiplier Float?
  @@unique([roomId, enemyId, isMobile])
}

model MazeCharacterPosition {
  id          Int       @id @default(autoincrement())
  mazeId      Int
  maze        Maze      @relation(fields:[mazeId], references:[id], onDelete:Cascade)
  characterId Int
  character   Character @relation(fields:[characterId], references:[id], onDelete:Cascade)
  roomId      Int
  room        MazeRoom  @relation("MazeRoomPositions", fields:[roomId], references:[id], onDelete:Cascade)
  previousRoomId Int?
  previousRoom  MazeRoom? @relation("MazeRoomPreviousPositions", fields:[previousRoomId], references:[id], onDelete:SetNull)
  status      String   @default("ACTIVE")
  lockReason  String?
  updatedAt   temporal.updatedAt()
  @@unique([mazeId, characterId])
}


model Perk {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  probability Float     @default(0)
  effects     Json      @default("[]")
  stackable   Boolean   @default(true)
  maxStacks   Int?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  characterPerks CharacterPerk[]
}

model CharacterPerk {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields:[characterId], references:[id], onDelete:Cascade)
  perkId      Int
  perk        Perk      @relation(fields:[perkId], references:[id], onDelete:Restrict)
  source      String    @default("MANUAL")
  createdAt   DateTime  @default(now())
  @@index([characterId])
  @@index([perkId])
}



model Business {
  id                    Int       @id @default(autoincrement())
  name                  String
  description           String?
  ownerCharacterId      Int
  ownerCharacter        Character @relation("BusinessOwner", fields:[ownerCharacterId], references:[id], onDelete:Restrict)
  passiveIncome         Int       @default(0)
  passiveFrequency      String    @default("WEEKLY")
  passiveDayOfWeek      Int       @default(0)
  passiveTime            String    @default("18:00")
  balance               Int       @default(0)
  securityInvestment    Int       @default(0)
  growthInvestment      Int       @default(0)
  active                 Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())
  positions             BusinessPosition[]
  paymentLogs           EconomyPaymentLog[]
  products              BusinessProduct[]
  subscriptionPlans     BusinessSubscriptionPlan[]
  investments           BusinessInvestment[]
  @@index([ownerCharacterId])
}

model BusinessPosition {
  id               Int       @id @default(autoincrement())
  businessId       Int?
  business         Business? @relation(fields:[businessId], references:[id], onDelete:Cascade)
  title            String
  description      String?
  startTime        String
  endTime          String
  salary           Int       @default(0)
  salaryFrequency  String    @default("DAILY")
  salaryDayOfWeek  Int       @default(0)
  payerType        String    @default("BUSINESS")
  payerCharacterId Int?
  payerCharacter   Character? @relation("PositionPayer", fields:[payerCharacterId], references:[id], onDelete:SetNull)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  contracts        EmploymentContract[]
  @@index([businessId])
  @@index([payerCharacterId])
}

model EmploymentContract {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation("EmploymentCharacter", fields:[characterId], references:[id], onDelete:Cascade)
  positionId  Int
  position    BusinessPosition @relation(fields:[positionId], references:[id], onDelete:Cascade)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  @@index([characterId, active])
  @@index([positionId, active])
}

model EconomyPaymentLog {
  id                   BigInt    @id @default(autoincrement())
  paymentType          String
  sourceType           String
  sourceId             Int
  recipientCharacterId Int
  recipientCharacter   Character @relation("EconomyRecipient", fields:[recipientCharacterId], references:[id], onDelete:Cascade)
  businessId           Int?
  business             Business? @relation(fields:[businessId], references:[id], onDelete:SetNull)
  amount               Int
  periodKey            String
  description          String
  createdAt            DateTime  @default(now())
  @@unique([paymentType, sourceId, recipientCharacterId, periodKey])
  @@index([recipientCharacterId, createdAt])
  @@index([businessId, createdAt])
}

model RuleSection {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@map("ruleSection")
  @@index([position, id])
}


model BusinessProduct {
  id            Int       @id @default(autoincrement())
  businessId    Int
  business      Business  @relation(fields:[businessId], references:[id], onDelete:Cascade)
  itemId        Int
  item          Item      @relation(fields:[itemId], references:[id], onDelete:Restrict)
  purchasePrice Int       @default(0)
  salePrice     Int       @default(0)
  stock         Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  @@unique([businessId, itemId])
  @@index([businessId, active])
}

model CharacterProperty {
  id            Int       @id @default(autoincrement())
  characterId   Int
  character     Character @relation(fields:[characterId], references:[id], onDelete:Cascade)
  itemId        Int
  item          Item      @relation(fields:[itemId], references:[id], onDelete:Restrict)
  businessId    Int?
  business     Business? @relation(fields:[businessId], references:[id], onDelete:SetNull)
  purchasePrice Int       @default(0)
  createdAt     DateTime  @default(now())
  @@index([characterId])
  @@index([itemId])
}

model BusinessSubscriptionPlan {
  id            Int       @id @default(autoincrement())
  businessId    Int
  business      Business  @relation(fields:[businessId], references:[id], onDelete:Cascade)
  name          String
  description   String?
  price         Int       @default(0)
  intervalValue Int       @default(1)
  intervalUnit  String    @default("MONTH")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  subscriptions BusinessSubscription[]
  @@index([businessId, active])
}

model BusinessSubscription {
  id           Int       @id @default(autoincrement())
  planId       Int
  plan         BusinessSubscriptionPlan @relation(fields:[planId], references:[id], onDelete:Cascade)
  characterId  Int
  character    Character @relation(fields:[characterId], references:[id], onDelete:Cascade)
  active       Boolean   @default(true)
  nextChargeAt DateTime
  lastChargedAt DateTime?
  createdAt    DateTime  @default(now())
  @@index([characterId, active])
  @@index([nextChargeAt, active])
}

model BusinessInvestment {
  id                Int       @id @default(autoincrement())
  businessId        Int
  business           Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  type              String
  sourceType        String
  sourceCharacterId Int?
  sourceCharacter   Character? @relation(fields:[sourceCharacterId], references:[id], onDelete:SetNull)
  amount            Int
  createdAt         DateTime  @default(now())
  @@index([businessId, type])
}

