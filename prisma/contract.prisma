model User {
  id         Int         @id @default(autoincrement())
  clerkId    String      @unique
  role       String      @default("PLAYER")
  email      String      @unique
  name       String?
  createdAt  DateTime    @default(now())
  lastLoginAt DateTime?
  lastLoginSessionId String?
  lastNotificationReadAt DateTime?
  characters Character[]
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
}

model Character {
  id        Int                 @id @default(autoincrement())
  name      String
  userId    Int
  user      User                @relation(fields:[userId], references:[id])
  age       Int?
  gender    String?
  height    Int?
  stats     CharacterStat?
  resources CharacterResource?
  modifiers CharacterModifier[]
  createdAt DateTime            @default(now())
  auditLogs AuditLog[]
}

model CharacterStat {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields:[characterId], references:[id])
  strength     Int       @default(0)
  agility      Int       @default(0)
  constitution Int       @default(0)
  intelligence Int       @default(0)
  wisdom       Int       @default(0)
  charisma     Int       @default(0)
  spirit       Int       @default(0)
  luck         Int       @default(0)

  @@unique([characterId])
}

model CharacterResource {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields:[characterId], references:[id])
  karma       Int       @default(0)
  money       Int       @default(0)
  levelUpPoints Int       @default(0)
  blackjackState String?

  @@unique([characterId])
}

model CharacterModifier {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields:[characterId], references:[id])
  stat        String
  amount      Int
  source      String
  expiresAt   DateTime?
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  actorUserId  Int?
  actorUser    User?    @relation("AuditActor", fields:[actorUserId], references:[id], onDelete:SetNull)
  action       String
  entityType   String
  entityId     Int?
  characterId  Int?
  character    Character? @relation(fields:[characterId], references:[id], onDelete:SetNull)
  targetUserId Int?
  targetUser   User?    @relation("AuditTarget", fields:[targetUserId], references:[id], onDelete:SetNull)
  details      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([characterId])
}


model Item {
  id             Int       @id @default(autoincrement())
  name           String
  description    String?
  itemType       String    @default("OTHER")
  acquisitionType String   @default("PURCHASABLE")
  price          Int       @default(0)
  effects        Json
  createdAt      DateTime  @default(now())
  characterItems CharacterItem[]
}

model CharacterItem {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields:[characterId], references:[id], onDelete:Cascade)
  itemId      Int
  item        Item      @relation(fields:[itemId], references:[id], onDelete:Cascade)
  quantity    Int       @default(1)
  equipped    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([characterId, itemId])
}
